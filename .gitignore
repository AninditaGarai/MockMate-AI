# .gitignore - Git ignore file

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
backend/venv/
backend/.venv/

# Environment variables
backend/.env
backend/.env.local
backend/.env.*.local

# Database
*.db
*.sqlite
*.sqlite3
backend/instance/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/

# Frontend build
frontend/build/
frontend/.vite/

# Logs
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# MacOS
.DS_Store
.AppleDouble
.LSOverride
*.sublime-workspace
*.sublime-project

# Windows
Thumbs.db
ehthumbs.db

# ML Models (optional - keep trained models in git)
# ml-model/models/*.pkl
# ml-model/models/*.h5

# Temporary files
tmp/
temp/
*.tmp

# OS specific
.env.production
.env.staging
