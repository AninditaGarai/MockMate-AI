# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mockmate_db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# JWT Configuration
SECRET_KEY=your_secret_key_here
